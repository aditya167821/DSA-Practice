#include <bits/stdc++.h>
using namespace std;

vector<int> missingNumbers(vector<int> arr, int n) {
    int mn = arr[0];
    int mx = arr[0];

    // Find minimum and maximum
    for (int i = 1; i < n; i++) {
        mn = min(mn, arr[i]);
        mx = max(mx, arr[i]);
    }

    // Mark present numbers
    vector<bool> present(mx + 1, false);

    for (int i = 0; i < n; i++) {
        present[arr[i]] = true;
    }

    vector<int> ans;

    // Find missing numbers
    for (int i = mn; i <= mx; i++) {
        if (!present[i]) {
            ans.push_back(i);
        }
    }

    return ans;
}
