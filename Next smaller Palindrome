string nextSmallerPalindrome(string S) {
    int n = S.length();

    // Single digit case
    if (n == 1) {
        return to_string(S[0] - '0' - 1);
    }

    string ans = S;

    // Left half ko right half par copy karo
    for (int i = 0; i < n / 2; i++) {
        ans[n - 1 - i] = ans[i];
    }

    // Agar palindrome already smaller hai
    if (ans < S) {
        return ans;
    }

    // Left half + middle ko 1 decrease karo
    int i = (n - 1) / 2;

    while (i >= 0 && ans[i] == '0') {
        ans[i] = '9';
        i--;
    }

    ans[i]--;

    // Dobara mirror karo
    for (int j = 0; j < n / 2; j++) {
        ans[n - 1 - j] = ans[j];
    }

    // Leading zero case: 1001 -> 999
    if (ans[0] == '0') {
        return string(n - 1, '9');
    }

    return ans;
}
