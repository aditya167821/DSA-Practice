#include <bits/stdc++.h>
using namespace std;

int minimumPathSum(vector<vector<int>> &triangle, int n) {
    // Last row ko DP array bana do
    vector<int> dp = triangle[n - 1];

    // Bottom se second row tak
    for (int i = n - 2; i >= 0; i--) {
        for (int j = 0; j <= i; j++) {
            dp[j] = triangle[i][j] + min(dp[j], dp[j + 1]);
        }
    }

    return dp[0];
}
