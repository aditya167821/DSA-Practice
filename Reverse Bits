#include <bits/stdc++.h>
using namespace std;
unsigned int reverseBits(unsigned int n)
{
    unsigned int ans = 0;

    for (int i = 0; i < 32; i++)
    {
        // Last bit of n
        int bit = n & 1;

        // Make space in ans
        ans = ans << 1;

        // Put extracted bit into ans
        ans = ans | bit;

        // Move to next bit
        n = n >> 1;
    }

    return ans;
}
