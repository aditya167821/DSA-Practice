#include <bits/stdc++.h>
using namespace std;

int distinctLeft(vector<int> &arr, int n, int k)
{
    sort(arr.begin(), arr.end());

    unordered_set<int> st;

    // Remaining elements after deleting K maximum elements
    for(int i = 0; i < n - k; i++)
    {
        st.insert(arr[i]);
    }

    return st.size();
}
