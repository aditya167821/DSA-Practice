#include <bits/stdc++.h>
using namespace std;

int platformsNeeded(int arrival[], int departure[], int n)
{
    sort(arrival, arrival + n);
    sort(departure, departure + n);

    int i = 1, j = 0;
    int platforms = 1;
    int ans = 1;

    while (i < n && j < n)
    {
        if (arrival[i] <= departure[j])
        {
            platforms++;
            ans = max(ans, platforms);
            i++;
        }
        else
        {
            platforms--;
            j++;
        }
    }

    return ans;
}
