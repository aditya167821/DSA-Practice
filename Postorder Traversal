void solve(TreeNode* root, vector<int>& ans) {
    if (root == NULL) {
        return;
    }

    // Left
    solve(root->left, ans);

    // Right
    solve(root->right, ans);

    // Root
    ans.push_back(root->data);
}

vector<int> postorderTraversal(TreeNode* root) {
    vector<int> ans;

    solve(root, ans);

    return ans;
}
